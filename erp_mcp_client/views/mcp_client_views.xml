<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_erp_mcp_client_list" model="ir.ui.view">
        <field name="name">erp.mcp.client.list</field>
        <field name="model">erp.mcp.client</field>
        <field name="arch" type="xml">
            <list string="MCP Registrations">
                <field name="name"/>
                <field name="registrar_url"/>
                <field name="odoo_url"/>
                <field name="mcp_url" optional="show"/>
                <field name="registration_state" widget="badge"
                       decoration-success="registration_state == 'registered'"
                       decoration-danger="registration_state == 'error'"
                       decoration-muted="registration_state == 'draft'"/>
            </list>
        </field>
    </record>

    <record id="view_erp_mcp_client_form" model="ir.ui.view">
        <field name="name">erp.mcp.client.form</field>
        <field name="model">erp.mcp.client</field>
        <field name="arch" type="xml">
            <form string="MCP Registration">
                <header>
                    <button name="action_register" type="object" string="Register"
                            class="btn-primary" icon="fa-paper-plane"
                            invisible="registration_state == 'registered'"/>
                    <button name="action_register" type="object" string="Re-register"
                            icon="fa-refresh"
                            invisible="registration_state != 'registered'"/>
                    <field name="registration_state" widget="statusbar"
                           statusbar_visible="draft,registered"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Registered" bg_color="text-bg-success"
                            invisible="registration_state != 'registered'"/>
                    <widget name="web_ribbon" title="Error" bg_color="text-bg-danger"
                            invisible="registration_state != 'error'"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. any Name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Registrar" invisible="1">
                            <field name="registrar_url" placeholder="https://mcp.mycompany.com"/>
                        </group>
                        <group string="Google OAuth">
                            <field name="google_client_id"/>
                            <field name="google_client_secret" password="True"/>
                              <div class="o_row mb-2">
                                <button name="action_open_google_cloud_console" type="object"
                                        string="Open Google Cloud Console" icon="fa-external-link"
                                        class="btn-link"/>
                            </div>
                        </group>
                    </group>
                    <group string="This Odoo Instance">
                        <group>
                            <label for="odoo_url"/>
                            <div class="o_row">
                                <field name="odoo_url" placeholder="https://myodoo.example.com" nolabel="1"/>
                                <button name="action_fill_odoo_url" type="object"
                                        string="Use this instance" icon="fa-magic"
                                        class="btn-link" title="Fill with this Odoo's base URL (https)"/>
                            </div>
                            <label for="odoo_db"/>
                            <div class="o_row">
                                <field name="odoo_db" placeholder="postgres-db-name" nolabel="1"/>
                                <button name="action_fill_odoo_db" type="object"
                                        string="Use current DB" icon="fa-database"
                                        class="btn-link" title="Fill with the current database name"/>
                            </div>
                        </group>
                        <group invisible="1">
                            <field name="odoo_login"/>
                            <field name="odoo_api_key" password="True"/>
                            <field name="odoo_admin_emails"
                                   placeholder="you@example.com, teammate@example.com"/>
                        </group>
                    </group>
                    <group string="Registration Result">
                        <field name="mcp_url" invisible="1"/>
                        <group string="URL`S" invisible="not mcp_url">
                            <field name="mcp_https_url" widget="CopyClipboardChar"/>
                            <field name="mcp_callback_url" widget="CopyClipboardChar"/>
                            <field name="mcp_ai_url" widget="CopyClipboardChar"/>
                        </group>
                        <group>
                            <field name="tenant_uuid"/>
                            <field name="remote_state"/>
                            <field name="registered_on"/>
                        </group>
                        <field name="last_error" readonly="1"
                               invisible="not last_error"
                               class="text-danger"/>
                    </group>
                    <notebook>
                        <page string="Access Roles" name="roles">
                            <field name="role_ids">
                                <list editable="bottom">
                                    <field name="role_name"/>
                                    <field name="odoo_api_key" password="True"/>
                                    <field name="emails"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_erp_mcp_client" model="ir.actions.act_window">
        <field name="name">MCP Registrations</field>
        <field name="res_model">erp.mcp.client</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_erp_mcp_client_root" name="MCP Connector" sequence="90" web_icon="erp_mcp_client,static/description/icon.png"/>
    <menuitem id="menu_erp_mcp_client_reg" name="Connectors"
              parent="menu_erp_mcp_client_root" action="action_erp_mcp_client" sequence="10"/>

</odoo>
